  ;; ══════════════════════════════════════════
  ;; End-to-end flows
  ;; ══════════════════════════════════════════
  (flows
    (flow user-message-lifecycle
      (description "user sends message -> orchestration -> foreground PTY response")
      (steps
        jarvis-ui/POST-chat-completions
        -> event-bus/UserMessageReceived
        -> message-persister/store-user-message
        -> orchestrator/should-skip-orchestration
        -> orchestrator/build-prompt-with-KB-and-beacons
        -> orchestrator-pty/jarvis_context_inject
        -> event-bus/ContextReady
        -> orchestrator/relay-to-foreground
        -> foreground-pty/send
        -> event-bus/TextComplete
        -> message-persister/store-assistant-message
        -> jarvis-ui/SSE-stream))

    (flow code-mutation-lifecycle
      (description "code change detected -> topology audit (audit-only, no auto-fix)")
      (steps
        git-watcher/HEAD-change OR watcher/Write-Edit-detected
        -> event-bus/CodebaseMutated
        -> topology-guardian/debounce-10s
        -> topology-manager/audit
        -> topology-manager/snapshot
        -> log-discrepancies))

    (flow intent-refinement-lifecycle
      (description "manual trigger or topology change -> reality snapshot -> Sonnet elevates to intent.lisp")
      (steps
        api/intent-refine-trigger OR event-bus/Custom-topology_changed
        -> event-bus/Custom-manual_intent_refine
        -> intent-refiner/debounce-2s
        -> reality-mirror/generate
        -> intent-refiner/spawn-sonnet-pty
        -> sonnet-pty/write-intent.lisp
        -> event-bus/Custom-intent_refined))

    (flow delta-detection-lifecycle
      (description "intent.lisp changes -> delta detection -> optional Sonnet validation -> fingerprint dedup -> Board task dispatch")
      (steps
        delta-monitor/notify-or-mtime-fallback
        -> reality-mirror/generate-fresh
        -> delta-detector/detect
        -> delta-validator/validate-optional
        -> delta-monitor/hash-deltas-dedup
        -> delta-detector/dispatch-tasks
        -> event-bus/Custom-deltas_detected))

    (flow kb-extraction-lifecycle
      (description "new messages -> extraction worker -> KB persistence")
      (steps
        watcher/scan-jsonl
        -> event-bus/MessagesIngested
        -> extraction-worker/tick-60s
        -> storage/get-pending-extraction-messages
        -> extraction-worker/spawn-sonnet-pty
        -> sonnet-pty/jarvis_kb_remember
        -> storage/kb-upsert
        -> extraction-worker/watermark-advance))))
